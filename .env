# STUDIO GPU worker secrets. Fill these ONCE and commit (per your setup).
# Generate tokens with:  openssl rand -hex 32
# NOTE: these must MATCH the operator/control-plane .env values.
CONTROL_PLANE_URL=https://your-operator.onrender.com
WORKER_TOKEN=REPLACE_WITH_WORKER_TOKEN
# optional: HF token if any gated model needs it
HF_TOKEN=
# optional: skip re-downloading weights when the cache is warm
SKIP_DOWNLOAD=0

# --- shared box (vai-dev2) GPU pinning ---
# Leave CUDA_VISIBLE_DEVICES empty to let gpu_pick.py choose a free card by UUID
# (recommended: it avoids the broken GPU 5 / index shift). To force a card, set
# the UUID here, e.g. the idle one:
#   CUDA_VISIBLE_DEVICES=GPU-8b870518-304a-92a4-b17e-c2633fca54e1
CUDA_VISIBLE_DEVICES=
# minimum free VRAM (GB) a card must have before the worker will use it
NEED_GB=40
