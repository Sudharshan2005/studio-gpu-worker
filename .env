# STUDIO GPU worker secrets. Fill these ONCE and commit (per your setup).
# Generate tokens with:  openssl rand -hex 32
# NOTE: these must MATCH the operator/control-plane .env values.
CONTROL_PLANE_URL=https://your-operator.onrender.com
WORKER_TOKEN=REPLACE_WITH_WORKER_TOKEN
# optional: HF token if any gated model needs it
HF_TOKEN=
# optional: skip re-downloading weights when the cache is warm
SKIP_DOWNLOAD=0
